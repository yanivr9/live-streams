<resources>
    <color name="desk_bg">#0E1113</color>

    <style name="Theme.StreamDesk" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/desk_bg</item>
        <item name="android:colorAccent">#FF9F1C</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Shown the moment the app is opened, until the channels are on screen: the logo on the app's dark background -->
    <style name="Theme.StreamDesk.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/desk_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">#1E272C</item>
        <item name="postSplashScreenTheme">@style/Theme.StreamDesk</item>
    </style>

    <style name="Theme.StreamDesk.Player">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
